<?xml version="1.0" encoding="utf-8"?>
<!-- Window background (splash) shown while the Calculator Lock disguise is
     enabled, so a cold start looks like a calculator from the first frame:
     dark background with the calculator logo centered. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="#1C1C1E" />
    </item>
    <item
        android:width="144dp"
        android:height="144dp"
        android:drawable="@drawable/ic_calculator_foreground"
        android:gravity="center" />
</layer-list>
